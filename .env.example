PORT=3000

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=QX7

# Bearer token required on /mcp (Authorization: Bearer <token>).
# Generate with: openssl rand -hex 32. If empty, /mcp is unauthenticated.
MCP_AUTH_TOKEN=

# Limits the brand style tools to one brand (master_brands.id, e.g. 3 = PROLOOK).
# If empty, they search all brands.
BRAND_ID=

# Debugging only: exposes list_tables, describe_table and query (direct DB access).
# Leave false so clients can only use the brand style tools.
ENABLE_RAW_SQL_TOOLS=false
