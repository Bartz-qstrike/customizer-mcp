  access_token_url   String?   @db.LongText
  webhook_client_id  String?   @db.VarChar(255)
  webhook_secret     String?   @db.VarChar(255)
  server_environment Json?

  @@index([app_domain], map: "application_tokens_app_domain_index")
  @@index([client_id], map: "application_tokens_client_id_index")
  @@index([dealer_id], map: "application_tokens_dealer_id_index")
  @@index([master_brand_id], map: "application_tokens_master_brand_id_index")
  @@index([status], map: "application_tokens_status_index")
}

