model application_tokens {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  dealer_id          Int
  master_brand_id    Int
  app_name           String    @db.VarChar(255)
  app_domain         String    @db.VarChar(255)
  email              String?   @db.VarChar(255)
  abilities          String?   @db.Text
  client_id          String    @unique(map: "application_tokens_client_id_unique") @db.VarChar(26)
  secret_key         String    @db.VarChar(60)
  rate_limit         Int       @default(0)
  request_count      BigInt    @default(0)
  last_used_at       DateTime? @db.Timestamp(0)
  expires_at         DateTime? @db.Timestamp(0)
  revoked_at         DateTime? @db.Timestamp(0)
  created_at         DateTime? @db.Timestamp(0)
  updated_at         DateTime? @db.Timestamp(0)
  status             Int       @default(1)
  deleted_at         DateTime? @db.Timestamp(0)
  callback_url       String?   @db.LongText
  bearer_token       String?   @db.LongText
